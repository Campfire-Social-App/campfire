ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://campfire:campfire@localhost:5432/campfire

JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Opcional: se definidos, o primeiro admin é criado (ou promovido) automaticamente
# no startup do servidor. Alternativa: `python -m app.cli create-admin --username ... --password ...`
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret1234567890devsecret
