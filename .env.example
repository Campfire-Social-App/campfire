# Referência das variáveis. Nenhum processo lê este arquivo nem um .env na raiz:
# cada seção abaixo corresponde a um arquivo próprio, todos fora do versionamento.
#
#   server/.env   dev local, lido pelo uvicorn rodado de dentro de server/
#   bots/.env     dev local, lido pelo uvicorn rodado de dentro de bots/
#   infra/.env    produção, lido pelo docker compose e pelo infra/deploy.sh
#
# O infra/docker-compose.dev.yml não usa .env nenhum — ele já passa os mesmos
# valores de dev por environment.

# --- server/.env (dev local) ---
DATABASE_URL=postgresql+asyncpg://campfire:campfire@localhost:5432/campfire
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# LIVEKIT_URL é o endereço devolvido aos clientes; LIVEKIT_API_URL é o que o
# servidor usa para as chamadas administrativas (moderação).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=324a9697e5bbde9de2844644ac03966ceab4bf67

# Onde o serviço de bots atende. Vazio = este deploy não tem bots: a lista de
# comandos volta vazia e o menu de "/" não aparece. Em produção o compose já
# fixa http://bots:8100, então esta linha é só do dev local.
BOTS_URL=http://127.0.0.1:8100

# --- Compartilhado entre server/.env e bots/.env (e infra/.env em produção) ---
# A conta que o serviço de bots usa. O servidor cria essa conta no boot com
# estas mesmas credenciais, então os dois lados precisam ler os mesmos valores.
BOT_USERNAME=ytdlp
BOT_PASSWORD=generate-with-openssl-rand-hex-16
# Prova para o serviço de bots que o comando veio mesmo do servidor.
BOTS_SHARED_SECRET=generate-with-openssl-rand-hex-24

# --- bots/.env (dev local) ---
CAMPFIRE_API_URL=http://127.0.0.1:8000
CAMPFIRE_GATEWAY_URL=ws://127.0.0.1:8000/gateway
# Vazio = o bot usa o endereço que POST /api/voice/{id}/token devolve, o mesmo
# dos clients. Em produção a variável equivalente no infra/.env é
# BOT_LIVEKIT_URL; só preencha (ws://livekit:7880) se a VPS não rotear o próprio
# IP público de volta para dentro (sem hairpin NAT).
LIVEKIT_URL_OVERRIDE=
FFMPEG_PATH=ffmpeg

# O YouTube decide por IP de origem se acredita que quem chama é gente, e um
# endereço de datacenter cai no "Sign in to confirm you're not a bot" muito mais
# fácil que um residencial. Estes dois são as saídas, e em produção vão no
# infra/.env (o compose repassa os dois nomes para o serviço).
#
# Clients do yt-dlp em ordem de tentativa; vazio usa o padrão dele. Numa
# varredura feita de um IP limpo, os únicos que resolvem sozinhos são visionos,
# android_vr e android — e só o visionos dispensa PO token, então comece por ele.
YTDLP_PLAYER_CLIENTS=
# Cookies em formato Netscape, se o de cima não bastar. Em produção ponha o
# arquivo em infra/bots-secrets/ (montado em /run/bots) e use uma conta
# descartável, nunca a sua. Ex.: /run/bots/youtube-cookies.txt
YTDLP_COOKIES_FILE=

# --- infra/.env (produção) ---
# Além de JWT_SECRET, FIRST_ADMIN_*, LIVEKIT_API_KEY/SECRET e do bloco de bots
# acima, o compose de produção precisa destes:
POSTGRES_USER=campfire
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
POSTGRES_DB=campfire

DOMAIN=seudominio.com
LIVEKIT_DOMAIN=livekit.seudominio.com

BOT_LIVEKIT_URL=
